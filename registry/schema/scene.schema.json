{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1215989787/dsh-fdehub/registry/schema/scene.schema.json",
  "title": "DSH FDEHub Scene Card",
  "description": "一条 AI+业务场景卡。核心约束：五要素必须齐全（插入点 / 输入 / 输出 / 人工兜底 / 判定指标）——说不清这五件事的，就不是场景，是口号。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "domain",
    "aiPattern",
    "injection",
    "inputs",
    "outputs",
    "humanInLoop",
    "proofMetric"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 40 },
    "domain": { "type": "string", "minLength": 1 },
    "industry": { "type": "string" },
    "summary": { "type": "string", "minLength": 8, "maxLength": 200 },
    "pain": { "type": "string" },
    "aiPattern": { "type": "string", "minLength": 1 },
    "injection": { "type": "string", "minLength": 4 },
    "inputs": { "type": "string", "minLength": 2 },
    "outputs": { "type": "string", "minLength": 2 },
    "humanInLoop": { "type": "string", "minLength": 2 },
    "proofMetric": { "type": "string", "minLength": 4 },
    "effort": { "enum": ["S", "M", "L"] },
    "metrics": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "org": { "type": "string" },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "published": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "repo": { "type": "string" },
    "url": { "type": "string" }
  }
}
